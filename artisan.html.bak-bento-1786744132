  var v=document.querySelector('.win video'), played=false;
  if(v) v.addEventListener('play',function(){if(!played){played=true;ev('demo_video_play',{});}});
  document.querySelectorAll('.tabx-btn').forEach(function(b){b.addEventListener('click',function(){ev('feature_view',{feature:b.textContent.trim()});});});
  document.querySelectorAll('.mtags a').forEach(function(a){a.addEventListener('click',function(){ev('metier_click',{metier:a.textContent.trim()});});});
  var seen={};
  window.addEventListener('scroll',function(){
    var d=document.documentElement,p=(d.scrollTop)/(d.scrollHeight-d.clientHeight);
    [25,50,75,90].forEach(function(m){if(p*100>=m&&!seen[m]){seen[m]=1;ev('scroll_depth',{percent:m});}});
  },{passive:true});
})();
</script>
