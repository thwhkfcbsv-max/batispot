<script>
(function(){
  var sec=document.querySelector('.dd-sec'); if(!sec) return;
  var tabs=sec.querySelectorAll('.dd-tab'), ins=sec.querySelectorAll('.dd-in');
  var lines=sec.querySelectorAll('.dd-line'), total=sec.querySelector('.dd-total'),
      sign=sec.querySelector('.dd-sign'), status=sec.querySelector('.dd-status'),
      transcript=sec.querySelector('.dd-transcript'), typed=sec.querySelector('.dd-typed'),
      cotes=sec.querySelectorAll('.dd-cotes span');
  var methods=['voix','photo','main'], idx=0, timers=[], playing=false;
  var texts={voix:'« Séjour 24 m², murs et plafond, deux couches, plus la prépa »',main:'Séjour 24 m², murs + plafond 2 couches, préparation'};
  function T(fn,ms){var t=setTimeout(fn,ms);timers.push(t);}
  function clearAll(){timers.forEach(clearTimeout);timers=[];}
  function reset(){
    lines.forEach(function(l){l.classList.remove('in')});
    total.classList.remove('in');sign.classList.remove('in');
    status.textContent='en cours…';transcript.textContent='';typed.textContent='';
    cotes.forEach(function(c){c.style.opacity=0});
  }
  function show(m){ins.forEach(function(el){el.classList.toggle('show',el.classList.contains(m))});}
  function typeText(el,txt,done){var i=0;(function step(){if(i<=txt.length){el.textContent=txt.slice(0,i++);T(step,26);}else if(done)done();})();}
  function buildDevis(){
    lines.forEach(function(l,i){T(function(){l.classList.add('in')},400+i*450);});
    T(function(){total.classList.add('in');status.textContent='chiffré ';},400+lines.length*450+300);
    T(function(){sign.classList.add('in');},400+lines.length*450+900);
  }
  function play(m){
    clearAll();reset();show(m);playing=true;
    if(m==='voix'){typeText(transcript,texts.voix,buildDevis);}
    else if(m==='main'){typeText(typed,texts.main,buildDevis);}
    else{ // photo
      cotes.forEach(function(c,i){T(function(){c.style.opacity=1;c.style.transition='.3s'},700+i*250);});
      T(buildDevis,1600);
    }
    // enchaîner la méthode suivante
    T(function(){idx=(idx+1)%methods.length;setTab(methods[idx]);play(methods[idx]);},6800);
  }
  function setTab(m){tabs.forEach(function(t){t.classList.toggle('on',t.dataset.m===m)});}
  tabs.forEach(function(t){t.addEventListener('click',function(){idx=methods.indexOf(t.dataset.m);setTab(t.dataset.m);play(t.dataset.m);});});
  // démarre quand la section entre à l'écran
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting&&!playing){play('voix');io.disconnect();}})},{threshold:.3});
  io.observe(sec);
})();
</script>

