<style>
:root{
  --ink:#0A1D14;--sub:#5E7268;--g1:#0F5132;--g2:#166534;--teal:#0D9488;--teal2:#14B8A6;
  --amber:#F59E0B;--line:#E4EDE8;--line2:#EDF3F0;--bg:#FBFCFB;--card:#FFF;--soft:#F1F7F4;--cta:#0F5132;--cta-h:#0b3f27;--r:20px;--maxw:1160px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:var(--bg);line-height:1.55;-webkit-font-smoothing:antialiased;letter-spacing:-.011em}
a{color:inherit;text-decoration:none}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
.ey{font-size:.78rem;font-weight:600;letter-spacing:.02em;color:var(--teal)}
h2.h{font-size:clamp(1.9rem,3.5vw,2.8rem);font-weight:800;line-height:1.06;letter-spacing:-.03em}

/* browser frame */
.win{border-radius:14px;overflow:hidden;box-shadow:0 30px 70px -24px rgba(10,29,20,.4);border:1px solid var(--line);background:#fff}
.win .bar{height:34px;background:#0d2b1e;display:flex;align-items:center;gap:7px;padding:0 14px}
.win .bar i{width:11px;height:11px;border-radius:50%;background:#2f4a3c}
.win .bar i:first-child{background:#ff5f57}.win .bar i:nth-child(2){background:#febc2e}.win .bar i:nth-child(3){background:#28c840}
.win img{width:100%;display:block}
.win video{width:100%;display:block}

/* NAV */
nav{position:sticky;top:0;z-index:50;background:rgba(251,252,251,.82);backdrop-filter:saturate(180%) blur(16px);border-bottom:1px solid var(--line2)}
.nav-in{max-width:var(--maxw);margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:.55rem;font-weight:800;font-size:1.1rem;letter-spacing:-.02em}
.brand .dot{width:26px;height:26px;border-radius:8px;background:linear-gradient(135deg,var(--g1),var(--teal));display:grid;place-items:center}
.brand .dot svg{width:15px;height:15px}
.brand em{font-style:normal;font-size:.6rem;font-weight:700;letter-spacing:.08em;color:#fff;background:var(--g1);padding:2px 6px;border-radius:5px}
.nav-cta{background:var(--cta);color:#fff;padding:.55rem 1.1rem;border-radius:10px;font-weight:600;font-size:.88rem;transition:.18s}
.nav-cta:hover{background:var(--cta-h);transform:translateY(-1px)}

/* HERO */
.hero{position:relative;overflow:hidden;padding:80px 0 40px;text-align:center}
.hero::before{content:"";position:absolute;top:-28%;left:50%;transform:translateX(-50%);width:1000px;height:720px;background:radial-gradient(ellipse at center,rgba(13,148,136,.14),transparent 62%);pointer-events:none}
.hero .badge{display:inline-flex;align-items:center;gap:.5rem;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:.4rem .9rem;font-size:.8rem;font-weight:600;color:var(--ink);box-shadow:0 1px 2px rgba(10,29,20,.04);margin-bottom:1.5rem}
.hero .badge .pip{width:7px;height:7px;border-radius:50%;background:var(--teal2);box-shadow:0 0 0 3px rgba(20,184,166,.18)}
.hero h1{font-size:clamp(2.2rem,5vw,3.9rem);font-weight:800;line-height:1.04;letter-spacing:-.04em;max-width:920px;margin:0 auto .9rem;background:linear-gradient(180deg,var(--ink),#204034);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p.lead{font-size:1.18rem;color:var(--sub);max-width:620px;margin:0 auto 2rem}
.hero .cta-row{display:flex;gap:.7rem;justify-content:center;flex-wrap:wrap}
.btn{padding:.85rem 1.5rem;border-radius:12px;font-weight:600;font-size:1rem;transition:.18s;display:inline-flex;align-items:center;gap:.5rem}
.btn-p{background:var(--cta);color:#fff;box-shadow:0 6px 20px rgba(15,81,50,.22)}
.btn-p:hover{background:var(--cta-h);transform:translateY(-2px)}
.btn-s{background:var(--card);color:var(--ink);border:1px solid var(--line)}
.btn-s:hover{border-color:var(--teal);color:var(--g1)}
.hero .trust{margin-top:1.4rem;font-size:.82rem;color:var(--sub)}
.hero-chips{display:flex;flex-wrap:wrap;gap:.55rem .6rem;justify-content:center;margin-top:1.5rem}
.hero-chips span{display:inline-flex;align-items:center;gap:.4rem;font-size:.86rem;font-weight:600;color:var(--g1);background:var(--soft);border:1px solid var(--line);border-radius:999px;padding:.42rem .9rem}
.hero-chips svg{width:15px;height:15px;color:var(--teal);flex-shrink:0}
.hero-shot{max-width:1240px;margin:52px auto 0;display:flex;align-items:flex-end;justify-content:center;gap:18px}
.hero-shot .win{flex:1;min-width:0}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.hero-phone{position:relative;width:184px;flex:0 0 184px;padding:8px;border-radius:34px;background:linear-gradient(150deg,#1e2d24,#070e0a);box-shadow:0 40px 70px -18px rgba(10,29,20,.55),inset 0 0 0 1px rgba(255,255,255,.07);z-index:3}
.hp-screens{position:relative;width:100%;aspect-ratio:390/844;border-radius:26px;overflow:hidden;background:#0a1510}
.hp-scr{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;opacity:0;transition:opacity .7s ease}
.hp-scr.on{opacity:1}
.hero-phone::before{content:"";position:absolute;top:50%;left:-3px;transform:translateY(-50%);width:3px;height:48px;border-radius:2px;background:#1e2d24}
.hero-phone::after{content:"";position:absolute;top:19px;left:50%;transform:translateX(-50%);width:34px;height:5px;border-radius:99px;background:rgba(0,0,0,.55);z-index:4}
@media(max-width:640px){.hero-phone{display:none}}

/* FEATURE ROWS */
section{padding:70px 0}
.sec-head{text-align:center;max-width:660px;margin:0 auto 3rem}
.sec-head .ey{display:block;margin-bottom:.7rem}
.sec-head p{color:var(--sub);margin-top:.8rem;font-size:1.05rem}
.frow{display:grid;grid-template-columns:1fr 1.25fr;gap:48px;align-items:center;margin-bottom:56px}
.frow:last-child{margin-bottom:0}
.frow.flip .fmedia{order:2}
.ftext .k{display:inline-flex;align-items:center;gap:.5rem;font-size:.74rem;font-weight:700;letter-spacing:.05em;color:var(--teal);background:var(--soft);border:1px solid var(--line);border-radius:999px;padding:.35rem .8rem;margin-bottom:1rem}
.ftext h3{font-size:1.7rem;font-weight:800;letter-spacing:-.025em;line-height:1.12;margin-bottom:.7rem}
.ftext p{color:var(--sub);font-size:1.02rem;margin-bottom:1rem}
.ftext ul{list-style:none;display:flex;flex-direction:column;gap:.5rem}
.ftext li{display:flex;gap:.6rem;align-items:flex-start;font-size:.95rem;font-weight:500}
.ftext li svg{width:18px;height:18px;color:var(--teal);flex-shrink:0;margin-top:2px}

/* STEPS */
.steps{background:var(--soft)}
.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;counter-reset:s}
.st .n{counter-increment:s;font-size:.85rem;font-weight:700;color:var(--teal)}
.st .n::before{content:"0" counter(s)}
.st h3{font-size:1.15rem;font-weight:700;margin:.5rem 0 .35rem;letter-spacing:-.02em}
.st p{color:var(--sub);font-size:.95rem}

/* CTA */
.cta-final{text-align:center}
.cta-card{background:linear-gradient(140deg,var(--g1),var(--teal));border-radius:28px;padding:64px 32px;color:#fff;position:relative;overflow:hidden}
.cta-card::before{content:"";position:absolute;inset:0;background:radial-gradient(120% 100% at 80% 0%,rgba(255,255,255,.14),transparent 55%)}
.cta-card h2{font-size:clamp(1.8rem,3.2vw,2.5rem);font-weight:800;letter-spacing:-.03em;margin-bottom:.7rem;position:relative}
.cta-card p{color:rgba(255,255,255,.82);margin-bottom:1.9rem;position:relative}
.cta-card form{display:flex;gap:.6rem;max-width:460px;margin:0 auto;flex-wrap:wrap;justify-content:center;position:relative}
.cta-card input{flex:1;min-width:210px;padding:.85rem 1.1rem;border:0;border-radius:11px;font-size:.95rem;font-family:inherit}
.cta-card button{background:#fff;color:var(--g1);border:0;padding:.85rem 1.6rem;border-radius:11px;font-weight:700;cursor:pointer;font-size:.95rem}
.cta-card .n{margin-top:1rem;font-size:.8rem;color:rgba(255,255,255,.7)}

.metiers{padding:56px 0;border-top:1px solid var(--line2)}
.metiers .ey{text-align:center;display:block;margin-bottom:1.1rem}
.mtags{display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center;max-width:800px;margin:0 auto}
.mtags a{background:var(--card);border:1px solid var(--line);border-radius:999px;padding:.42rem .95rem;font-size:.86rem;font-weight:500;color:var(--ink);transition:.15s}
.mtags a:hover{border-color:var(--teal);color:var(--g1)}
footer{padding:36px 24px;text-align:center;color:var(--sub);font-size:.85rem;border-top:1px solid var(--line2)}

.js .reveal{opacity:0;transform:translateY(20px);transition:opacity .65s cubic-bezier(.2,.7,.2,1),transform .65s cubic-bezier(.2,.7,.2,1)}
.js .reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.js .reveal{opacity:1;transform:none;transition:none}.hero-shot .win{animation:none}}
@media(max-width:840px){.frow,.frow.flip .fmedia{grid-template-columns:1fr;order:0}.steps-grid{grid-template-columns:1fr}}
</style>
</head>
