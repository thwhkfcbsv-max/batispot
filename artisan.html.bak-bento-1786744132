<script>
(function(){
  var UTM=(function(){try{var p=new URLSearchParams(location.search),o={},got=false;
    ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'].forEach(function(x){if(p.get(x)){o[x]=p.get(x);got=true;}});
    if(got)localStorage.setItem('bs_utm',JSON.stringify(o));
    return JSON.parse(localStorage.getItem('bs_utm')||'{}');}catch(e){return {};}})();
  function ev(n,p){ p=p||{}; for(var k in UTM){p[k]=UTM[k];} if(window.gtag) gtag('event',n,p); }
  document.querySelectorAll('.btn-p').forEach(function(a){a.addEventListener('click',function(){ev('cta_click',{location:'primary'});});});
  document.querySelectorAll('.btn-s').forEach(function(a){a.addEventListener('click',function(){ev('cta_click',{location:'secondary'});});});
