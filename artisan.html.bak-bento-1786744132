<script>
(function(){
  // Planning depuis devis
  var sec=document.querySelector('.pl-sec');
  if(sec){
    var btn=sec.querySelector('.pl-btn'),cal=sec.querySelector('.pl-cal'),blks=sec.querySelectorAll('.pl-blk');
    var tk=[];function reset(){cal.classList.remove('on');btn.classList.remove('click');blks.forEach(function(b){b.classList.remove('in')});}
    function play(){reset();
      tk.push(setTimeout(function(){btn.classList.add('click');},900));
      tk.push(setTimeout(function(){btn.classList.remove('click');cal.classList.add('on');},1300));
      blks.forEach(function(b,i){tk.push(setTimeout(function(){b.classList.add('in');},1600+i*300));});
      tk.push(setTimeout(play,7000));
    }
    btn.addEventListener('click',function(){tk.forEach(clearTimeout);tk=[];play();});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){play();io.disconnect();}})},{threshold:.3});io.observe(sec);
  }
  // Messagerie équipe
  var body=document.getElementById('msgBody');
  if(body){
    var msgs=[
      {w:"Karim (Chef)",i:"KB",me:false,t:"On attaque le bâchage et le ponçage ce matin sur Dupont."},
      {w:"Luc",i:"LM",me:false,t:"Reçu, je charge les bâches et le rouleau à poncer."},
      {w:"Vous",i:"MD",me:true,t:"Parfait. Pensez au masquage des prises avant l'impression."},
      {w:"Karim (Chef)",i:"KB",me:false,t:"C'est noté. Je vous envoie une photo dans 1h."}
    ];
    function row(m){var r=document.createElement('div');r.className='msg-row'+(m.me?' me':'');
      r.innerHTML='<div class="msg-ava">'+m.i+'</div><div class="msg-b">'+(m.me?'':'<div class="who">'+m.w+'</div>')+m.t+'</div>';return r;}
    var t=[];function run(k){if(k>=msgs.length){t.push(setTimeout(function(){body.innerHTML='';run(0);},3800));return;}
      body.appendChild(row(msgs[k]));t.push(setTimeout(function(){run(k+1);},1500));}
    var io2=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){run(0);io2.disconnect();}})},{threshold:.3});io2.observe(body);
  }
})();
</script>

