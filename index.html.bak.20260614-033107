<script>
// Form submit → Edge Function notify-admin (capture fiable du lead + email admin)
// (remplace l'ancien /api/discovery-lead inexistant qui perdait les leads)
document.getElementById('devis-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('btn-submit');
  btn.disabled = true;
  btn.textContent = 'Envoi…';
  const p = Object.fromEntries(new FormData(e.target).entries());
  const SB = 'https://cisniwhaiydazdpzvino.supabase.co';
  const KEY = 'sb_publishable_LUXdyprriDy-_wcr7-r8Yw_3N8AP_s1';
  try {
    await fetch(`${SB}/functions/v1/notify-admin`, {
      method: 'POST',
      headers: { 'apikey': KEY, 'authorization': `Bearer ${KEY}`, 'content-type': 'application/json' },
      body: JSON.stringify({
        subject: `Nouveau lead HOME — ${p.type || 'travaux'} — ${p.cp || ''}`,
        data: {
          prenom: p.prenom || '', nom: p.nom || '',
          telephone: p.tel || '', email: p.email || '',
          type_travaux: p.type || '', code_postal: p.cp || '',
          budget: p.budget || '', description: p.desc || '',
          source: 'formulaire accueil',
        },
        reply_to: p.email || undefined,
      }),
    });
  } catch (err) {}
  // + CAPTURE dans demandes_devis (le lead n'est plus perdu ; dispatch auto vers les artisans ACTIFS)
  try {
    await fetch(`${SB}/rest/v1/demandes_devis`, {
      method: 'POST',
      headers: { 'apikey': KEY, 'authorization': `Bearer ${KEY}`, 'content-type': 'application/json', 'Prefer': 'return=minimal' },
      body: JSON.stringify({
        client_id: null,
        adresse: 'Non précisée',
        client_name: ((p.prenom || '') + ' ' + (p.nom || '')).trim() || null,
        client_email: (p.email || '').trim().toLowerCase() || null,
        client_phone: (p.tel || '').trim() || null,
        code_postal: (p.cp || '').trim() || null,
        type_travaux: p.type || null,
        description: p.desc || null,
        budget_estime: p.budget || null,
      }),
    });
  } catch (err) {}
  if (window.fbq) fbq('track', 'Lead');  // conversion Meta Pixel
  document.querySelector('.form-card').classList.add('submitted');
  document.getElementById('form-success').classList.add('active');
});
</script>

<!-- Chat widget BatiSpot (lazy load 5s ou au 1er event) -->
<script>
(function(){
  function _loadChat(){
    if(window._chatLoaded) return; window._chatLoaded=true;
    var s=document.createElement("script");
    s.src="/chat-widget.js?v=3";
    document.body.appendChild(s);
  }
  ["click","scroll","keydown","touchstart"].forEach(function(e){
    document.addEventListener(e,_loadChat,{once:true,passive:true});
  });
  setTimeout(_loadChat,5000);
})();
</script>
