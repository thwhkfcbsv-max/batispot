<style>
@font-face { font-family: 'Inter'; src: url('/fonts/inter-var.woff2') format('woff2-variations'), url('/fonts/inter-var.woff2') format('woff2'); font-weight: 100 900; font-style: normal; font-display: swap; }

:root {
  --g1:#1A6B45; --g2:#228B5B; --g3:#4CAF82;
  --g-soft:#EBF7F1; --g-cream:#F7FBF8;
  --cta:#166534; --cta-h:#0f4a2f;
  --text:#1C2B22; --sub:#3D5A4E;
  --border:rgba(34,139,91,0.12);
  --shadow:rgba(26,107,69,0.08);
  --white:#fff;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',system-ui,-apple-system,sans-serif;color:#1F2937;background:#fff;line-height:1.6;-webkit-font-smoothing:antialiased}

/* === NAV === */
.bs-nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:0 3%;height:72px;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}
.bs-nav .logo{display:flex;align-items:center;gap:.5rem;text-decoration:none;flex-shrink:0}
.bs-nav .pro-tag{background:var(--g1);color:#fff;font-size:.6rem;font-weight:900;padding:2px 8px;border-radius:6px;text-transform:uppercase;letter-spacing:1px;margin-left:.4rem;vertical-align:middle}
.bs-nav .nav-links{display:flex;gap:1.6rem;list-style:none;flex-shrink:0}
.bs-nav .nav-links a{text-decoration:none;color:var(--sub);font-weight:500;font-size:.92rem;white-space:nowrap;transition:color .2s}
.bs-nav .nav-links a:hover{color:var(--g1)}
.bs-nav .nav-switch{display:flex;align-items:center;gap:1rem;flex-shrink:0}
.bs-nav .nav-pro-link{font-size:.85rem;font-weight:600;color:var(--sub);text-decoration:none;white-space:nowrap}
.bs-nav .nav-cta{background:var(--cta);color:#fff;padding:.6rem 1.4rem;border-radius:10px;font-weight:800;font-size:.9rem;text-decoration:none;white-space:nowrap;transition:background .2s,transform .1s}
.bs-nav .nav-cta:hover{background:var(--cta-h);transform:translateY(-1px)}
@media(max-width:1100px){.bs-nav .nav-pro-link{display:none}}
@media(max-width:900px){.bs-nav .nav-links li:nth-child(n+4){display:none}}

/* === HERO PRO === */
.pro-hero{position:relative;background:linear-gradient(135deg,#0d3320 0%,var(--g1) 50%,var(--g2) 100%);padding:80px 5% 90px;color:#fff;overflow:hidden}
.pro-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,rgba(255,255,255,0.06) 0%,transparent 50%),radial-gradient(circle at 20% 80%,rgba(76,175,130,0.15) 0%,transparent 50%);pointer-events:none}
.pro-hero-inner{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;position:relative;z-index:2}
.pro-eyebrow{display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);backdrop-filter:blur(8px);padding:.4rem 1rem;border-radius:20px;font-size:.78rem;font-weight:700;color:#fff;margin-bottom:1.4rem}
.pro-eyebrow::before{content:'';width:8px;height:8px;border-radius:50%;background:#22C55E;box-shadow:0 0 0 3px rgba(34,197,94,0.3);animation:bs-pulse 2s infinite}
@keyframes bs-pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.65;transform:scale(.92)}}
.pro-hero h1{font-size:clamp(2rem,4vw,3.4rem);font-weight:900;line-height:1.1;letter-spacing:-.02em;margin-bottom:1.2rem}
.pro-hero h1 em{font-style:normal;color:#FCD34D}
.pro-hero-text > p{font-size:1.1rem;color:rgba(255,255,255,0.85);margin-bottom:2rem;max-width:480px}
.pro-hero-trust{display:flex;flex-direction:column;gap:.6rem;margin-bottom:2rem}
.pro-trust-item{display:flex;align-items:center;gap:.7rem;font-size:.92rem;color:rgba(255,255,255,0.92)}
.pro-trust-check{width:24px;height:24px;border-radius:50%;background:#FCD34D;color:#0d3320;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:900;flex-shrink:0}
.pro-hero-cta{display:flex;gap:.8rem;flex-wrap:wrap}
.btn-pro-primary{background:#FCD34D;color:#0d3320;padding:.95rem 2rem;border-radius:12px;font-weight:900;font-size:1rem;text-decoration:none;display:inline-flex;align-items:center;gap:.5rem;transition:transform .15s,box-shadow .2s;box-shadow:0 8px 24px rgba(0,0,0,0.2)}
.btn-pro-primary:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(0,0,0,0.3)}
.btn-pro-secondary{background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.25);backdrop-filter:blur(8px);color:#fff;padding:.95rem 1.6rem;border-radius:12px;font-weight:800;font-size:.95rem;text-decoration:none;transition:background .2s}
.btn-pro-secondary:hover{background:rgba(255,255,255,0.18)}

/* === Pro form card === */
.pro-form-card{background:#fff;border-radius:24px;padding:2.2rem 2rem;box-shadow:0 20px 60px rgba(0,0,0,0.18);color:var(--text)}
.pro-form-header{margin-bottom:1.4rem}
.pro-form-header h2{font-size:1.3rem;font-weight:900;color:var(--g1);margin-bottom:.3rem}
.pro-form-header p{font-size:.88rem;color:var(--sub)}
.pro-form-header .pulse-tag{display:inline-flex;align-items:center;gap:.4rem;background:#F0FDF4;border:1px solid rgba(34,139,91,0.2);padding:.25rem .7rem;border-radius:999px;font-size:.7rem;font-weight:700;color:var(--g1);margin-bottom:.6rem}
.pro-form-header .pulse-tag::before{content:'';width:8px;height:8px;border-radius:50%;background:#22C55E;box-shadow:0 0 0 3px rgba(34,197,94,0.18);animation:bs-pulse 2s infinite}
.fg{margin-bottom:.85rem}
.fg label{display:block;font-size:.76rem;font-weight:700;color:var(--text);margin-bottom:.3rem}
.fg input,.fg select{width:100%;padding:.7rem 1rem;border:1.5px solid #E5E7EB;border-radius:10px;font-size:.9rem;color:var(--text);background:#FAFAF9;outline:none;font-family:inherit;transition:border-color .2s,box-shadow .2s}
.fg input:focus,.fg select:focus{border-color:var(--g3);box-shadow:0 0 0 3px rgba(76,175,130,0.12);background:#fff}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
.btn-submit{width:100%;padding:.95rem;background:var(--cta);color:#fff;border:none;border-radius:12px;font-size:1rem;font-weight:900;cursor:pointer;box-shadow:0 6px 20px rgba(42,157,110,0.25);transition:background .2s,transform .1s;margin-top:.4rem}
.btn-submit:hover{background:var(--cta-h);transform:translateY(-1px)}
.btn-submit:disabled{opacity:.55;cursor:wait}
.form-note{text-align:center;font-size:.74rem;color:var(--sub);margin-top:.6rem}

/* === Sections === */
section.bs-section{padding:96px 5%}
.section-inner{max-width:1180px;margin:0 auto}
.section-head{text-align:center;max-width:640px;margin:0 auto 4rem}
.tag{display:inline-block;background:var(--g-soft);color:var(--g1);padding:.28rem .85rem;border-radius:20px;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.5px;margin-bottom:.8rem;border:1px solid var(--border)}
.section-head h2{font-size:clamp(1.6rem,3vw,2.4rem);font-weight:900;color:var(--text);line-height:1.2;margin-bottom:.8rem;letter-spacing:-.015em}
.section-head p{color:var(--sub);font-size:1rem}

/* === Avantages === */
.bs-avantages{background:var(--g-soft)}
.avantages-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem}
.avantage-card{background:#fff;border-radius:18px;padding:2rem 1.6rem;box-shadow:0 4px 20px var(--shadow);border:1px solid var(--border);transition:transform .2s,box-shadow .2s}
.avantage-card:hover{transform:translateY(-4px);box-shadow:0 14px 38px rgba(26,107,69,0.12)}
.av-icon{width:56px;height:56px;border-radius:16px;background:var(--g-soft);display:flex;align-items:center;justify-content:center;margin-bottom:1.1rem;color:var(--g1)}
.avantage-card h3{font-size:1.05rem;font-weight:900;color:var(--text);margin-bottom:.5rem}
.avantage-card p{font-size:.88rem;color:var(--sub);line-height:1.6}

/* === Étapes === */
.steps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2rem}
.step-card{text-align:center}
.step-num{width:54px;height:54px;border-radius:50%;background:var(--cta);color:#fff;font-size:1.2rem;font-weight:900;display:flex;align-items:center;justify-content:center;margin:0 auto 1.2rem;box-shadow:0 6px 18px rgba(42,157,110,0.28)}
.step-card h3{font-size:1rem;font-weight:900;color:var(--text);margin-bottom:.5rem}
.step-card p{font-size:.88rem;color:var(--sub);line-height:1.6}

/* === Garanties (dark) === */
.bs-garanties{background:#0a1c10;color:#fff;padding:96px 5%}
.bs-garanties .section-head h2{color:#fff}
.bs-garanties .section-head p{color:rgba(255,255,255,0.65)}
.bs-garanties .tag{background:rgba(255,255,255,0.08);color:#FCD34D;border-color:rgba(255,255,255,0.18)}
.garanties-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.4rem}
.garantie-card{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:1.6rem 1.5rem;backdrop-filter:blur(6px)}
.gr-icon{width:42px;height:42px;border-radius:12px;background:rgba(252,211,77,0.15);display:flex;align-items:center;justify-content:center;color:#FCD34D;margin-bottom:1rem}
.garantie-card h3{font-size:1rem;font-weight:800;color:#fff;margin-bottom:.4rem}
.garantie-card p{font-size:.85rem;color:rgba(255,255,255,0.7);line-height:1.6}

/* === Pricing === */
.bs-pricing{background:#fff;text-align:center}
.pricing-card{max-width:480px;margin:0 auto;background:linear-gradient(135deg,var(--g-cream) 0%,#fff 100%);border:2px solid var(--g3);border-radius:24px;padding:2.5rem 2rem;box-shadow:0 20px 60px rgba(26,107,69,0.10);position:relative}
.pricing-card .ribbon{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--g1);color:#fff;font-size:.7rem;font-weight:900;padding:.4rem 1rem;border-radius:6px;text-transform:uppercase;letter-spacing:1px}
.price-amount{font-size:3.2rem;font-weight:900;color:var(--g1);line-height:1;margin:.6rem 0 .2rem;letter-spacing:-.02em}
.price-amount .currency{font-size:2rem;vertical-align:top;font-weight:800}
.price-amount .period{font-size:1rem;color:var(--sub);font-weight:700;margin-left:.3rem}
.price-tag{font-size:.85rem;color:var(--sub);margin-bottom:1.5rem}
.price-features{list-style:none;text-align:left;max-width:340px;margin:1.6rem auto 2rem;display:flex;flex-direction:column;gap:.7rem}
.price-features li{display:flex;align-items:start;gap:.7rem;font-size:.92rem;color:var(--text)}
.price-features svg{flex-shrink:0;color:var(--g2);margin-top:2px}
.btn-pricing{display:inline-block;background:var(--cta);color:#fff;padding:1rem 2.6rem;border-radius:12px;font-size:1rem;font-weight:900;text-decoration:none;box-shadow:0 8px 24px rgba(42,157,110,0.28);transition:background .2s,transform .15s}
.btn-pricing:hover{background:var(--cta-h);transform:translateY(-2px)}

/* === Témoignages === */
.bs-temoignages{background:var(--g-soft)}
.temoignages-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.4rem}
.temoignage-card{background:#fff;border-radius:18px;padding:1.8rem 1.6rem;box-shadow:0 4px 20px var(--shadow);border:1px solid var(--border)}
.temoignage-card blockquote{font-size:.95rem;color:var(--text);line-height:1.6;margin-bottom:1.2rem;font-style:italic;position:relative;padding-left:1.4rem}
.temoignage-card blockquote::before{content:'"';position:absolute;left:0;top:-12px;font-size:3.5rem;color:var(--g3);font-family:Georgia,serif;line-height:1}
.temoignage-author{display:flex;align-items:center;gap:.8rem}
.temoignage-author .avatar{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--g2),var(--g3));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:1rem}
.temoignage-author .info{font-size:.85rem}
.temoignage-author .info strong{display:block;color:var(--text);font-weight:800}
.temoignage-author .info span{color:var(--sub);font-size:.78rem}

/* === CTA Final === */
.bs-cta-final{background:linear-gradient(135deg,#0d3320 0%,var(--g1) 50%,var(--g2) 100%);text-align:center;padding:96px 5%;color:#fff}
.bs-cta-final h2{font-size:clamp(1.6rem,3vw,2.4rem);font-weight:900;color:#fff;margin-bottom:1rem;letter-spacing:-.015em}
.bs-cta-final p{font-size:1rem;color:rgba(255,255,255,0.8);max-width:520px;margin:0 auto 2rem}
.cta-final-btn{display:inline-block;background:#FCD34D;color:#0d3320;padding:1rem 2.8rem;border-radius:14px;font-size:1.05rem;font-weight:900;text-decoration:none;box-shadow:0 8px 24px rgba(0,0,0,0.2);transition:transform .15s}
.cta-final-btn:hover{transform:translateY(-2px)}

/* === Footer === */
.bs-footer{background:#0a1c10;color:rgba(255,255,255,0.72);padding:2.5rem 5%;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;font-size:.8rem}
.bs-footer .f-logo{font-size:1.2rem;font-weight:900;color:#fff;text-decoration:none}
.bs-footer a{color:rgba(255,255,255,0.65);text-decoration:none}
.footer-links{display:flex;gap:1.5rem;flex-wrap:wrap}

@media(max-width:900px){
  .pro-hero-inner{grid-template-columns:1fr;gap:2.5rem}
  .form-row{grid-template-columns:1fr}
}
/* Hamburger mobile + dropdown menu */
.nav-burger{display:none;background:none;border:none;cursor:pointer;width:42px;height:42px;align-items:center;justify-content:center;color:var(--g1);border-radius:8px;flex-shrink:0}
.nav-burger:hover{background:var(--g-soft)}
.nav-burger svg{width:26px;height:26px}
.nav-mobile{display:none;position:fixed;top:60px;left:0;right:0;background:#fff;border-bottom:1px solid var(--border);box-shadow:0 8px 24px rgba(15,31,23,.08);z-index:99;animation:nav-slide-down .2s ease}
.nav-mobile.open{display:block}
.nav-mobile a{display:block;padding:14px 20px;font-size:15px;font-weight:600;color:var(--text);text-decoration:none;border-bottom:1px solid var(--border)}
.nav-mobile a:hover{background:var(--g-cream);color:var(--g1)}
.nav-mobile a.nav-mobile-cta{background:var(--cta);color:#fff;font-weight:800;text-align:center;border-bottom:none;margin:14px 20px;padding:14px 20px;border-radius:10px}
.nav-mobile a.nav-mobile-cta:hover{background:var(--cta-h);color:#fff}
@keyframes nav-slide-down{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:900px){
  .bs-nav{padding:0 4%;height:60px;gap:.5rem}
  .bs-nav .nav-links,.bs-nav .nav-switch{display:none}
  .bs-nav .pro-tag{display:none}
  .bs-nav .logo svg{width:130px;height:34px}
  .nav-burger{display:flex}
}
