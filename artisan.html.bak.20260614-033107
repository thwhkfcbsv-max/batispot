<script>
// Compteur dynamique chantiers en attente (pseudo-réel : seed sur date + variation horaire)
(function(){
  const el = document.getElementById('dynamic-chantiers-count');
  if (!el) return;
  const now = new Date();
  // Seed quotidien : YYYY-MM-DD → chiffre stable dans la journée
  const seed = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate();
  const hash = (seed * 9301 + 49297) % 233280;
  let base = 8 + (hash % 15); // 8 à 22 selon le jour
  // Petite variation horaire (-2 à +3) pour effet "ça bouge" si l'artisan revient quelques heures plus tard
  const hourMod = ((now.getHours() * 17 + now.getMinutes() * 3) % 6) - 2;
  const total = Math.max(5, base + hourMod);
  el.textContent = total;
})();

